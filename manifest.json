{
  "manifest_version": 3,
  "name": "Leetcode Coding Helper",
  "version": "1.0.0",
  "description": "A helper extension for coding on Leetcode",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "marked.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}